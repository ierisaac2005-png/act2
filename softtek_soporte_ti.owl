  <rdf:Description rdf:about="https://example.org/softtek-academico/soporte-ti">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="es">Soporte TI — caso académico inspirado en Softtek</rdfs:label>
    <rdfs:comment xml:lang="es">Modelo independiente de la actividad del ciclo de vida. Personas, casos y sistemas ficticios; no describe procesos internos verificados de Softtek. Generado en RDF/XML para abrirse y editarse en Protégé.</rdfs:comment>
    <owl:versionInfo>1.0</owl:versionInfo>
  </rdf:Description>
